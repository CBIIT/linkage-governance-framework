{
  "name": "cgf-visual-model",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "build": "npm run assets:build && npx @11ty/eleventy",
    "build-ghpages": "npm run assets:build && npx @11ty/eleventy --pathprefix=/linkage-governance-framework/",
    "clean": "rimraf public",
    "assets:autoprefix": "postcss public/assets/styles/*.css -r --use autoprefixer",
    "assets:build": "node ./config/buildAssets && npm run assets:autoprefix",
    "assets:clean": "rimraf public/assets",
    "assets:refresh": "npm run assets:clean && npm run assets:build",
    "assets:watch": "chokidar 'assets/' -c 'npm run assets:refresh' --polling",
    "dev": "npm run clean && npm-run-all -p dev:assets dev:serve",
    "dev:clean": "npm run clean && npm run dev",
    "dev:assets": "npm run assets:refresh && npm run assets:watch",
    "dev:debug": "DEBUG=* npx @11ty/eleventy --serve --watch",
    "dev:serve": "npx @11ty/eleventy --serve --watch",
    "pa11y-ci:sitemap": "sleep 10; pa11y-ci --sitemap http://localhost:8080/sitemap.xml --sitemap-exclude \"/*.pdf\"  --sitemap-exclude \"/admin\" --sitemap-find \"^/\" --sitemap-replace \"http://localhost:8080/\"",
    "test": "echo \"Error: no test specified\" && exit 1",
    "serve": "npx @11ty/eleventy --serve",
    "start": "npx --node-options='--experimental-require-module' @11ty/eleventy --serve"
  },
  "keywords": [],
  "author": "",
  "license": "CC0-1.0",
  "type": "commonjs",
  "devDependencies": {
    "@11ty/eleventy": "^3.1.5",
    "chai": "^6.2.2",
    "check-html-links": "^0.2.4",
    "chokidar-cli": "^3.0.0",
    "js-yaml": "^4.1.1",
    "jsdom": "^29.1.1",
    "markdown-it": "^14.3.0",
    "markdown-it-attrs": "^4.3.1",
    "markdown-it-deflist": "^3.0.0",
    "markdown-it-footnote": "^4.0.0",
    "mocha": "^11.7.6",
    "npm-run-all": "^4.1.5",
    "pa11y-ci": "^4.1.1",
    "postcss": "^8.5.15",
    "postcss-cli": "^11.0.1",
    "rimraf": "^6.1.3"
  },
  "dependencies": {
    "@11ty/eleventy-fetch": "^5.1.2",
    "@11ty/eleventy-img": "^6.0.4",
    "@11ty/eleventy-navigation": "^1.0.5",
    "@uswds/uswds": "^3.13.0",
    "autoprefixer": "^10.5.0",
    "dotenv": "^17.4.2",
    "eleventy-plugin-toc": "^1.1.5",
    "esbuild": "^0.28.1",
    "esbuild-sass-plugin": "^3.7.0",
    "tippy.js": "^6.3.7"
  }
}
